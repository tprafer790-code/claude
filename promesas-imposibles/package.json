{
  "name": "promesas-imposibles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Promesas Imposibles / Impossible Promises — simulador político satírico para navegador.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:poki": "tsc --noEmit && vite build --mode poki",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "vite-node scripts/validate.ts",
    "simulate": "vite-node scripts/simulate.ts",
    "e2e": "node scripts/e2e.mjs",
    "symmetry": "vite-node scripts/symmetry.ts",
    "check": "npm run typecheck && npm run validate && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
