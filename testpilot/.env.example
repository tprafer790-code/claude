# Copiar este archivo como ".env" y rellenar. El archivo .env NO se sube al repositorio.

# Vacia = MODO SIMULADO: no se llama a ninguna API y el planificador devuelve
# respuestas de prueba (mock.js). Con clave = planificador real (Claude).
ANTHROPIC_API_KEY=

# Solo en modo simulado:
#   success = el fallo de prueba se repara y la prueba termina en exito
#   fail    = el planificador se declara bloqueado y la prueba termina en fallo
#   stuck   = un boton no responde, se reintenta y el orquestador aborta
MOCK_SCENARIO=success

# Modelo de Claude que planifica y repara las acciones
ANTHROPIC_MODEL=claude-sonnet-5-5

# Objetivo de la prueba en lenguaje natural (tambien vale --goal "...")
TEST_GOAL=

# Numero maximo de consultas a Claude por ejecucion
MAX_HEALS=5

# URL que se abre si no se pasa ninguna por linea de comandos
TARGET_URL=https://example.com

# "false" = se ve la ventana del navegador (recomendado para validar Cloudflare)
HEADLESS=false

# Opcional: ruta a un Chromium concreto. Dejar vacio para usar el de Playwright.
CHROMIUM_PATH=
