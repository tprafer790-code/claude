# Copiar este archivo como ".env" y rellenar. El archivo .env NO se sube al repositorio.
ANTHROPIC_API_KEY=

# URL que se abre si no se pasa ninguna por linea de comandos
TARGET_URL=https://example.com

# "false" = se ve la ventana del navegador (recomendado para validar Cloudflare)
HEADLESS=false

# Opcional: ruta a un Chromium concreto. Dejar vacio para usar el de Playwright.
CHROMIUM_PATH=
